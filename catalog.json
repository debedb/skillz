{
  "$schema": "https://github.com/voitta-ai/skillz/blob/master/scripts/catalog.schema.json",
  "version": 1,
  "description": "Catalog of skills, collections, and plugin bundles distributable from this repo.",
  "skills": [
    {
      "name": "work-on-pr",
      "path": "skills/work-on-pr/SKILL.md",
      "hosts": ["claude", "codex"],
      "summary": "Author-side PR iteration loop."
    },
    {
      "name": "review-pr-loop",
      "path": "skills/review-pr-loop/SKILL.md",
      "hosts": ["claude", "codex"],
      "summary": "Reviewer-side PR iteration loop."
    },
    {
      "name": "continuous-learning",
      "path": "skills/continuous-learning/SKILL.md",
      "hosts": ["codex"],
      "summary": "End-of-task retrospective: extract reusable, verified learnings as Codex skills."
    },
    {
      "name": "cmux-search",
      "path": "skills/cmux-search/SKILL.md",
      "hosts": ["claude", "codex"],
      "summary": "Search all open cmux workspaces/tabs/panes - live scrollback + agent transcripts."
    },
    {
      "name": "gh-git-heredoc-body-file",
      "path": "skills/gh-git-heredoc-body-file/SKILL.md",
      "hosts": ["claude", "codex"],
      "summary": "Use a body-file so gh CLI and git stop mangling multi-line bodies with backticks, code blocks, or $(...)."
    },
    {
      "name": "claude-code-static-allow-bypasses-hook",
      "path": "skills/claude-code-static-allow-bypasses-hook/SKILL.md",
      "hosts": ["claude", "codex"],
      "summary": "Why a Claude Code PreToolUse hook never fires for some commands: static permissions.allow Bash globs short-circuit it."
    },
    {
      "name": "python-ast-static-analyzer-scoping",
      "path": "skills/python-ast-static-analyzer-scoping/SKILL.md",
      "hosts": ["claude", "codex"],
      "summary": "Build a Python ast analyzer that resolves import aliases and models module-load vs deferred execution."
    }
  ],
  "collections": [
    {
      "name": "pr-loop",
      "path": "collections/pr-loop.json",
      "summary": "Paired PR-loop skills: work-on-pr (author) + review-pr-loop (reviewer). Legacy install.sh selector; prefer the pr-loop plugin entry.",
      "skills": ["work-on-pr", "review-pr-loop"]
    }
  ],
  "plugins": [
    {
      "name": "skillz",
      "claude_manifest": "plugins/skillz/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/skillz/.codex-plugin/plugin.json",
      "claude_marketplace": ".claude-plugin/marketplace.json",
      "codex_marketplace": ".codex-plugin/marketplace.json",
      "hosts": ["claude", "codex"],
      "skills": ["work-on-pr", "review-pr-loop", "continuous-learning", "cmux-search", "gh-git-heredoc-body-file", "claude-code-static-allow-bypasses-hook", "python-ast-static-analyzer-scoping"],
      "summary": "Full repo bundle: every skill in one plugin."
    },
    {
      "name": "pr-loop",
      "claude_manifest": "plugins/pr-loop/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/pr-loop/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["work-on-pr", "review-pr-loop"],
      "summary": "Paired PR-loop plugin: work-on-pr + review-pr-loop."
    },
    {
      "name": "work-on-pr",
      "claude_manifest": "plugins/work-on-pr/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/work-on-pr/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["work-on-pr"],
      "summary": "Single-skill plugin: work-on-pr."
    },
    {
      "name": "review-pr-loop",
      "claude_manifest": "plugins/review-pr-loop/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/review-pr-loop/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["review-pr-loop"],
      "summary": "Single-skill plugin: review-pr-loop."
    },
    {
      "name": "cmux-search",
      "claude_manifest": "plugins/cmux-search/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/cmux-search/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["cmux-search"],
      "summary": "Single-skill plugin: cmux-search."
    },
    {
      "name": "gh-git-heredoc-body-file",
      "claude_manifest": "plugins/gh-git-heredoc-body-file/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/gh-git-heredoc-body-file/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["gh-git-heredoc-body-file"],
      "summary": "Single-skill plugin: gh-git-heredoc-body-file."
    },
    {
      "name": "claude-code-static-allow-bypasses-hook",
      "claude_manifest": "plugins/claude-code-static-allow-bypasses-hook/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/claude-code-static-allow-bypasses-hook/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["claude-code-static-allow-bypasses-hook"],
      "summary": "Single-skill plugin: claude-code-static-allow-bypasses-hook."
    },
    {
      "name": "python-ast-static-analyzer-scoping",
      "claude_manifest": "plugins/python-ast-static-analyzer-scoping/.claude-plugin/plugin.json",
      "codex_manifest": "plugins/python-ast-static-analyzer-scoping/.codex-plugin/plugin.json",
      "hosts": ["claude", "codex"],
      "skills": ["python-ast-static-analyzer-scoping"],
      "summary": "Single-skill plugin: python-ast-static-analyzer-scoping."
    },
    {
      "name": "continuous-learning",
      "codex_manifest": "plugins/continuous-learning/.codex-plugin/plugin.json",
      "hosts": ["codex"],
      "skills": ["continuous-learning"],
      "summary": "Codex-only single-skill plugin: continuous-learning (no hooks)."
    },
    {
      "name": "codex-continuous-learning",
      "codex_manifest": "plugins/codex-continuous-learning/.codex-plugin/plugin.json",
      "hosts": ["codex"],
      "skills": ["continuous-learning"],
      "summary": "Codex-only plugin bundle: continuous-learning skill plus UserPromptSubmit + Stop hooks that drive an end-of-task retrospective."
    }
  ],
  "defaults": {
    "no_arg_install": "pr-loop"
  }
}
